# Optional: override the default Formspree endpoint used by vendor fallback
# and legacy Stripe webhook handlers. Defaults to the same endpoint the
# application form uses (mbdzblrb).
# FORMSPREE_VENDOR_URL=https://formspree.io/f/your_vendor_form_id

# Sponsor interest form endpoint used by the client-side sponsor form.
VITE_FORMSPREE_SPONSOR_URL=https://formspree.io/f/your_sponsor_form_id

# Legacy only: needed if receiving old Stripe checkout.session.completed events.
# New vendor submissions no longer require payment.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
